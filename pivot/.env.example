# PIVOT Online — variables d'environnement
# Copier ce fichier en .env et adapter

# Serveur
PORT=4242
NODE_ENV=production

# Base de données PostgreSQL
# Format alwaysdata : postgres://USER:PASS@postgresql-TONCOMPTE.alwaysdata.net:5432/USER_db
DATABASE_URL=postgres://pivot:pivot@localhost:5432/pivot

# SSL : auto-activé si l'URL contient "alwaysdata.net" ou si DB_SSL=true
DB_SSL=false
# Taille du pool de connexions (alwaysdata max 50/user, Render 20 par défaut)
DB_POOL_MAX=10

# Secret JWT (CHANGE-LE en prod — ex: openssl rand -hex 32)
JWT_SECRET=change-me-please-make-this-long-and-random
JWT_EXPIRES=7d

# Origine autorisée pour CORS
# Sur alwaysdata/Render, le site est sur https://TONCOMPTE.alwaysdata.net/ ou https://TONAPP.onrender.com
CLIENT_ORIGIN=*

# Compte admin par défaut créé au premier démarrage si aucun admin n'existe
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Saison courante (durée en jours, par défaut 30)
SEASON_DAYS=30
